---
import { getLangFromUrl } from "../i18n/utils";
import { useTranslations } from "../i18n/ui";

interface Props {
  term: string;
}

const { term } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const lexicon = useTranslations(lang).lexicon as Record<string, string>;
const definition = lexicon[term] ?? lexicon.fallback;
---

<span class="lexicon-term" tabindex="0" role="button" aria-haspopup="true" aria-expanded="false"><slot /><span class="lexicon-popover" role="tooltip" data-nosnippet><span class="lexicon-popover__card"></span><strong class="lexicon-popover__title">{term}</strong><span class="lexicon-popover__body">{definition}</span></span></span><script>
  function initLexicon() {
    const terms = document.querySelectorAll('.lexicon-term');

    function positionPopover(term: Element) {
      const popover = term.querySelector('.lexicon-popover') as HTMLElement | null;
      if (!popover) return;

      const margin = 12;
      const termRect = term.getBoundingClientRect();
      const popWidth = popover.offsetWidth;

      const center = termRect.left + termRect.width / 2;
      const naturalLeft = center - popWidth / 2;
      const naturalRight = center + popWidth / 2;

      let shift = 0;
      if (naturalLeft < margin) {
        shift = margin - naturalLeft;
      } else if (naturalRight > window.innerWidth - margin) {
        shift = window.innerWidth - margin - naturalRight;
      }
      popover.style.setProperty('--lex-shift', `${shift}px`);
    }

    terms.forEach((term) => {

      term.addEventListener('click', (e) => {
        e.stopPropagation();
        e.preventDefault();
        const isActive = term.classList.contains('is-active');

        document.querySelectorAll('.lexicon-term.is-active').forEach((other) => {
          if (other !== term) {
            other.classList.remove('is-active');
            other.setAttribute('aria-expanded', 'false');
          }
        });

        if (isActive) {
          term.classList.remove('is-active');
          term.setAttribute('aria-expanded', 'false');
        } else {
          term.classList.add('is-active');
          term.setAttribute('aria-expanded', 'true');
          positionPopover(term);
        }
      });

      term.addEventListener('mouseenter', () => positionPopover(term));
      term.addEventListener('focus', () => positionPopover(term));

      term.addEventListener('keydown', (e: any) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          (term as HTMLElement).click();
        }
        if (e.key === 'Escape') {
          term.classList.remove('is-active');
          term.setAttribute('aria-expanded', 'false');
        }
      });
    });

    document.addEventListener('click', () => {
      document.querySelectorAll('.lexicon-term.is-active').forEach((term) => {
        term.classList.remove('is-active');
        term.setAttribute('aria-expanded', 'false');
      });
    });

    window.addEventListener('resize', () => {
      document.querySelectorAll('.lexicon-term.is-active').forEach(positionPopover);
    });
  }

  initLexicon();

  document.addEventListener('astro:after-swap', initLexicon);
</script><style>
  
  .lexicon-term {
    --lex-cue: var(--honey-deep);

    position: relative;
    display: inline;
    cursor: help;
    color: inherit;
    font-weight: 700;

    text-decoration-line: underline;
    text-decoration-style: dotted;
    text-decoration-color: var(--lex-cue);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;

    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition:
      text-decoration-color 0.18s ease,
      text-underline-offset 0.18s ease;
  }

  .lexicon-term:hover,
  .lexicon-term:focus-visible,
  .lexicon-term.is-active {
    text-decoration-style: solid;
    text-underline-offset: 0.14em;
  }

  :global(.hero) .lexicon-term {
    --lex-cue: color-mix(in srgb, var(--ink) 50%, transparent);
  }

  :global(.site-footer) .lexicon-term {
    --lex-cue: var(--honey);
  }

  .lexicon-popover {
    --lex-shift: 0px;
    position: absolute;
    bottom: 135%;
    left: 50%;
    transform: translateX(calc(-50% + var(--lex-shift))) translateY(8px);
    width: min(250px, calc(100vw - 24px));
    padding: var(--space-3) var(--space-4);
    font-size: 0.9rem;
    line-height: 1.45;
    
    z-index: 2000;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: 
      opacity 0.22s cubic-bezier(0.175, 0.885, 0.32, 1.15),
      transform 0.22s cubic-bezier(0.175, 0.885, 0.32, 1.15),
      visibility 0.22s;
    text-align: left;
    font-family: var(--font-body);
    font-weight: 600;
    
    -webkit-text-stroke: 0;
    text-shadow: none;
    paint-order: normal;
    text-transform: none;
    letter-spacing: normal;
  }

  .lexicon-popover__card {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--cream);
    border: 3px solid var(--navy);
    border-radius: 12px;
    box-shadow: 0 0 0 1px var(--navy), 4px 4px 0 var(--navy);
    z-index: 1;
  }

  .lexicon-popover__title {
    position: relative;
    z-index: 3;
    display: block;
    font-family: var(--font-accent);
    color: var(--honey-deep);
    font-size: 1.1rem;
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border-bottom: 2px solid var(--line);
    padding-bottom: 4px;
  }

  .lexicon-popover__body {
    position: relative;
    z-index: 3;
    color: var(--navy);
  }

  .lexicon-popover::before {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 35px; 
    background: transparent;
    z-index: 0;
  }

  .lexicon-popover::after {
    content: "";
    position: absolute;
    top: 100%;
    
    left: calc(50% - var(--lex-shift));
    transform: translateX(-50%) translateY(-4px) rotate(45deg);
    width: 16px;
    height: 16px;
    background: var(--cream);
    border-bottom: 3px solid var(--navy);
    border-right: 3px solid var(--navy);
    z-index: 2; 
  }

  .lexicon-term:hover .lexicon-popover,
  .lexicon-term:focus-visible .lexicon-popover,
  .lexicon-term.is-active .lexicon-popover {
    opacity: 1;
    visibility: visible;
    transform: translateX(calc(-50% + var(--lex-shift))) translateY(0);
    pointer-events: auto;
  }

  .lexicon-term:focus-visible {
    outline: 3px solid var(--lex-cue);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .lexicon-popover {
      transition: none !important;
    }
  }
</style>
