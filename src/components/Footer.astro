---
import RichText from "./RichText.astro";
import HexBg from "./HexBg.astro";
import CloudTransition from "./CloudTransition.astro";
import { getLangFromUrl, localizedPath } from "../i18n/utils";
import { useTranslations, developerName, developerLink } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navLinks = [
  { label: t.nav.home, path: "/" },
  { label: t.nav.foyer, path: "/foyer/rdc" },
  { label: t.nav.guides, path: "/guides" },
  { label: t.nav.events, path: "/events" },
  { label: t.nav.contact, path: "/contact" },
];
---

<footer class="site-footer" id="site-footer">
  <CloudTransition class="footer-clouds" />

  <div class="footer__inner-wrap">
    <!-- Subtle hex texture over the dark ink background -->
    <HexBg
      radius={52}
      gap={4}
      opacity={0.055}
      color="var(--honey)"
      strokeWidth={1.5}
      hexagons={[]}
      maskImage="linear-gradient(to bottom, transparent 0%, rgba(255,255,255,0.4) 30%, rgba(255,255,255,0.4) 70%, transparent 100%)"
    />

    <!-- ── Main grid ─────────────────────────────────────────── -->
    <div class="footer__body">
      <div class="container footer__grid">
        <!-- Col 1 · Brand ────────────────────────────────────── -->
        <div class="footer__col footer__col--brand">
          <a
            class="footer__brand-link"
            href={localizedPath("/", lang)}
            aria-label={t.nav.brandHome}
          >
            <img
              class="footer__logo-img"
              src="/imgs/logo.webp"
              alt=""
              width="80"
              height="69"
            />
            <span class="footer__wordmark" dir="ltr">Welcom’</span>
          </a>

          <p class="footer__tagline">{t.footer.tagline}</p>

          <div class="footer__socials">
            <a
              class="footer__social-pill"
              href="https://www.instagram.com/welcom_int"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                class="footer__social-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle
                  cx="17.5"
                  cy="6.5"
                  r="1"
                  fill="currentColor"
                  stroke="none"></circle>
              </svg>
              <bdi>@welcom_int</bdi>
            </a>
            <a
              class="footer__social-pill"
              href="mailto:association.welcom@imtbs-tsp.eu"
            >
              <svg
                class="footer__social-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <polyline points="2,4 12,13 22,4"></polyline>
              </svg>
              Email
            </a>
          </div>
        </div>

        <!-- Col 2 · Navigation ───────────────────────────────── -->
        <div class="footer__col footer__col--nav">
          <div class="footer__col-label">
            <svg class="footer__col-hex" viewBox="0 0 12 11" aria-hidden="true"
              ><polygon points="6,0 12,3 12,8 6,11 0,8 0,3" fill="currentColor"
              ></polygon></svg
            >
            {t.nav.brandHome}
          </div>
          <ul class="footer__nav-list">
            {
              navLinks.map((l) => (
                <li>
                  <a
                    class="footer__nav-link"
                    href={localizedPath(l.path, lang)}
                  >
                    {l.label}
                    <svg
                      class="footer__nav-chevron"
                      viewBox="0 0 8 14"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <polyline points="1,1 7,7 1,13" />
                    </svg>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Col 3 · Contact ──────────────────────────────────── -->
        <div class="footer__col footer__col--contact">
          <div class="footer__col-label">
            <svg class="footer__col-hex" viewBox="0 0 12 11" aria-hidden="true"
              ><polygon points="6,0 12,3 12,8 6,11 0,8 0,3" fill="currentColor"
              ></polygon></svg
            >
            {t.nav.contact}
          </div>

          <address class="footer__address">
            <a
              class="footer__contact-item footer__contact-item--link"
              href="https://www.instagram.com/welcom_int"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="footer__contact-item-label">Instagram</span>
              <span class="footer__contact-item-value"
                ><bdi>@welcom_int</bdi></span
              >
            </a>
            <a
              class="footer__contact-item footer__contact-item--link"
              href="mailto:association.welcom@imtbs-tsp.eu"
            >
              <span class="footer__contact-item-label">Email</span>
              <span class="footer__contact-item-value"
                ><bdi>association.welcom<wbr />@imtbs-tsp.eu</bdi></span
              >
            </a>
            <a
              class="footer__contact-item footer__contact-item--link"
              href="https://maps.app.goo.gl/BkE7fHqtwXX4cz4FA"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="footer__contact-item-label">Adresse</span>
              <span class="footer__contact-item-value"
                ><bdi>9 Rue Charles Fourier,<br />91011 Évry-Courcouronnes</bdi
                ></span
              >
            </a>
          </address>

          <p class="footer__dev-line">
            {t.footer.dev.split("{name}")[0]}<a
              href={developerLink}
              target="_blank"
              rel="noopener noreferrer"
              class="footer__dev-link">{developerName}</a
            >{t.footer.dev.split("{name}")[1]}
          </p>
        </div>
      </div>
    </div>

    <!-- ── Divider ───────────────────────────────────────────── -->
    <div class="footer__rule-wrap" aria-hidden="true">
      <div class="container">
        <div class="footer__rule">
          <div class="footer__rule-line"></div>
          <div class="footer__rule-comb">
            {
              [0, 1, 2, 3, 4].map((i) => (
                <svg
                  class="footer__rule-hex"
                  style={`animation-delay:${i * 0.12}s`}
                  viewBox="0 0 14 13"
                  aria-hidden="true"
                >
                  <polygon
                    points="7,0.5 13.5,3.5 13.5,9.5 7,12.5 0.5,9.5 0.5,3.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                </svg>
              ))
            }
          </div>
          <div class="footer__rule-line"></div>
        </div>
      </div>
    </div>

    <!-- ── Bottom bar ────────────────────────────────────────── -->
    <div class="footer__bottom">
      <div class="container footer__bottom-inner">
        <p class="footer__credits"><RichText text={t.footer.credits} /></p>
        <a href="#top" class="footer__top-btn" aria-label={t.footer.backToTop}>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="12" y1="19" x2="12" y2="5"></line>
            <polyline points="5 12 12 5 19 12"></polyline>
          </svg>
          <span>{t.footer.top}</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* ── Shell ───────────────────────────────────────────────── */
  .site-footer {
    position: relative;
    z-index: 10;
  }

  :global(.footer-clouds) {
    position: absolute;
    bottom: 100% !important;
    left: 0;
    width: 100%;
    height: clamp(35px, 4.5vw, 55px);
    z-index: 3;
    pointer-events: none;
  }

  .footer__inner-wrap {
    position: relative;
    background: var(--ink);
    color: var(--cream);
    overflow: hidden;
  }

  .container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: clamp(var(--space-5), 4vw, var(--space-7));
  }

  /* ── Body grid ───────────────────────────────────────────── */
  .footer__body {
    position: relative;
    z-index: 2;
    padding-block: clamp(var(--space-7), 8vw, var(--space-9))
      clamp(var(--space-6), 6vw, var(--space-8));
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(var(--space-6), 5vw, var(--space-8));
  }

  @media (min-width: 680px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__col--brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 960px) {
    .footer__grid {
      grid-template-columns: 1.7fr 1fr 1.4fr;
      align-items: start;
    }
    .footer__col--brand {
      grid-column: auto;
    }
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* ── Brand ───────────────────────────────────────────────── */
  .footer__brand-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    width: fit-content;
  }

  .footer__logo-img {
    width: 80px;
    height: auto;
    object-fit: contain;
    flex-shrink: 0;
    filter: drop-shadow(3px 4px 0 rgba(30, 42, 61, 0.45));
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .footer__brand-link:hover .footer__logo-img {
    transform: rotate(-10deg) scale(1.1);
  }

  .footer__wordmark {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4vw, 2.8rem);
    line-height: 1;
    color: var(--honey);
    text-shadow:
      3px 3px 0 rgba(30, 42, 61, 0.6),
      0 0 40px rgba(239, 171, 67, 0.15);
    letter-spacing: -0.01em;
  }

  .footer__tagline {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--sky);
    max-width: 36ch;
    margin: 0;
  }

  /* Social pills */
  .footer__socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .footer__social-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--ink);
    background: var(--honey);
    border: 2px solid rgba(30, 42, 61, 0.35);
    border-radius: var(--radius-pill);
    padding: 0.42em 1.05em 0.42em 0.75em;
    text-decoration: none;
    box-shadow: 2px 3px 0 rgba(30, 42, 61, 0.35);
    transition:
      background-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .footer__social-pill:hover {
    background: var(--honey-deep);
    box-shadow: 3px 4px 0 rgba(30, 42, 61, 0.45);
  }

  .footer__social-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  /* ── Column labels ───────────────────────────────────────── */
  .footer__col-label {
    font-family: var(--font-accent);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--honey);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }

  .footer__col-hex {
    width: 10px;
    height: 9px;
    color: var(--honey);
    opacity: 0.7;
    flex-shrink: 0;
  }

  /* ── Nav links ───────────────────────────────────────────── */
  .footer__nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .footer__nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    color: var(--cream);
    text-decoration: none;
    padding: 0.55em var(--space-3);
    border-radius: 10px;
    border: 1.5px solid transparent;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      transform 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.25);
  }

  .footer__nav-chevron {
    width: 7px;
    height: 12px;
    flex-shrink: 0;
    color: var(--honey);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  .footer__nav-link:hover {
    background: rgba(239, 171, 67, 0.1);
    border-color: rgba(239, 171, 67, 0.25);
    color: var(--honey);
    transform: translateX(3px);
  }

  .footer__nav-link:hover .footer__nav-chevron {
    opacity: 1;
    transform: translateX(0);
  }

  /* ── Contact ─────────────────────────────────────────────── */
  .footer__address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__contact-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
  }

  .footer__contact-item-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: rgba(145, 176, 204, 0.6);
  }

  .footer__contact-item-value {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--cream);
    line-height: 1.5;
    transition: color 0.15s ease;
  }

  .footer__contact-item--link:hover .footer__contact-item-value {
    color: var(--honey);
  }

  .footer__dev-line {
    font-size: 0.875rem;
    color: var(--sky);
    opacity: 0.75;
    margin: 0;
  }

  .footer__dev-link {
    color: var(--honey);
    font-weight: 800;
    text-decoration: none;
    border-bottom: 1.5px dashed rgba(239, 171, 67, 0.5);
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .footer__dev-link:hover {
    color: var(--cream);
    border-color: var(--cream);
  }

  /* ── Rule / divider ──────────────────────────────────────── */
  .footer__rule-wrap {
    position: relative;
    z-index: 2;
    padding-block: 0;
  }

  .footer__rule {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .footer__rule-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgba(239, 171, 67, 0.35) 15%,
      rgba(239, 171, 67, 0.35) 85%,
      transparent
    );
  }

  .footer__rule-comb {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .footer__rule-hex {
    width: 14px;
    height: 13px;
    color: var(--honey);
    opacity: 0.4;
    animation: hexPulse 3s ease-in-out infinite alternate;
  }

  .footer__rule-hex:nth-child(3) {
    opacity: 0.65;
    transform: scale(1.2);
  }

  @keyframes hexPulse {
    from {
      opacity: 0.3;
    }
    to {
      opacity: 0.55;
    }
  }

  /* ── Bottom bar ──────────────────────────────────────────── */
  .footer__bottom {
    position: relative;
    z-index: 2;
    padding-block: var(--space-5);
  }

  .footer__bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .footer__credits {
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(145, 176, 204, 0.65);
    margin: 0;
    max-width: 65ch;
  }

  .footer__credits :global(.lexicon-term) {
    color: var(--sky);
    border-bottom-color: currentColor;
    font-weight: 700;
    opacity: 1;
  }
  .footer__credits :global(.lexicon-term:hover) {
    color: var(--honey);
    border-bottom-color: var(--honey);
  }

  /* Back to top */
  .footer__top-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-accent);
    font-size: 0.875rem;
    color: var(--ink);
    background: var(--honey);
    border: 2.5px solid rgba(30, 42, 61, 0.4);
    border-radius: var(--radius-button);
    padding: 0.5em 0.9em;
    text-decoration: none;
    box-shadow: 3px 3px 0 rgba(30, 42, 61, 0.4);
    white-space: nowrap;
    flex-shrink: 0;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .footer__top-btn svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .footer__top-btn:hover {
    background: var(--honey-deep);
    box-shadow: 4px 5px 0 rgba(30, 42, 61, 0.45);
  }

  .footer__top-btn:active {
    box-shadow: 1px 2px 0 rgba(30, 42, 61, 0.4);
  }

  /* ── Mobile ──────────────────────────────────────────────── */
  @media (max-width: 679px) {
    .footer__bottom-inner {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: var(--space-4);
    }
    .footer__credits {
      max-width: none;
    }
  }

  /* ── Reduced motion ──────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .footer__logo-img,
    .footer__social-pill,
    .footer__nav-link,
    .footer__nav-chevron,
    .footer__top-btn,
    .footer__rule-hex {
      transition: none !important;
      transform: none !important;
      animation: none !important;
    }
    .footer__nav-chevron {
      opacity: 0.4;
    }
    .footer__rule-hex {
      opacity: 0.4;
    }
  }
</style>
