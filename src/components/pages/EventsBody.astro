---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../SiteHeader.astro";
import HexBg from "../HexBg.astro";
import HoneyDrip from "../HoneyDrip.astro";
import RichText from "../RichText.astro";
import Footer from "../Footer.astro";
import { getLangFromUrl, localizedPath } from "../../i18n/utils";
import { useTranslations } from "../../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const e = t.eventsPage;

// ── Campus calendar (build-time fetch → client-side week navigation) ────
interface CalEvent {
  id: string;
  title: string;
  start_time: string;
  location: string;
  org_name: string;
  org_color: string;
}

let calEvents: CalEvent[] = [];
try {
  const now = new Date();
  // Start from Monday of the current week so in-progress-week events show
  const day = now.getDay();
  const weekStart = new Date(now);
  weekStart.setDate(now.getDate() - (day === 0 ? 6 : day - 1));
  weekStart.setHours(0, 0, 0, 0);
  const end = new Date(weekStart);
  end.setDate(weekStart.getDate() + 91); // ~13 weeks
  const res = await fetch(
    `https://cal.minet.net/api/events/?size=500&start_date=${weekStart.toISOString()}&end_date=${end.toISOString()}&upcoming=false`,
  );
  if (res.ok) {
    const raw: { items: any[] } = await res.json();
    calEvents = (raw.items ?? []).map((ev) => ({
      id: ev.id ?? '',
      title: ev.title ?? '',
      start_time: ev.start_time ?? '',
      location: ev.location ?? '',
      org_name: ev.organization?.name ?? '',
      org_color: ev.organization?.color_primary ?? '',
    }));
  }
} catch {
  // degrades gracefully — calendar shows empty state
}

// Year-round line-up, in display order. Keys map to e.yearRound entries.
const yearRound = [
  e.yearRound.bbq,
  e.yearRound.oktoberfest,
  e.yearRound.stpatrick,
  e.yearRound.absinthe,
];
---

<Base title={t.meta.events.title}>
  <span id="top"></span>
  <SiteHeader />
  <main>
    <!-- ── Hero: a year of good buzz ─────────────────────────── -->
    <section class="hero">
      <HexBg
        radius={46}
        gap={6}
        opacity={0.1}
        color="var(--navy)"
        strokeWidth={2}
        hexagons={[]}
        maskImage="radial-gradient(ellipse 120% 100% at 50% 45%, white 30%, transparent 85%)"
      />
      <div class="container hero__inner">
        <div class="hero__bee" aria-hidden="true">
          <img src="/imgs/bee.svg" alt="" width="120" height="120" />
        </div>
        <h1 class="hero__title">{e.heroTitle}</h1>
        <p class="hero__lede"><RichText text={e.heroLede} /></p>
      </div>
      <HoneyDrip fill="var(--cream)" />
    </section>

    <!-- ── Featured (flagship) events ────────────────────────── -->
    <section class="band band--featured">
      <div class="container">
        <p class="eyebrow"><span class="eyebrow__hex" aria-hidden="true"></span>{e.featuredEyebrow}</p>
        <h2>{e.featuredTitle}</h2>

        <!-- Global Village -->
        <article class="feature">
          <figure class="feature__photo">
            <img
              class="zoomable"
              src="/imgs/assoc/event-global-village.webp"
              alt={e.globalVillage.photoAlt}
              width="1200"
              height="800"
              loading="lazy"
            />
            <figcaption class="feature__caption"><RichText text={e.globalVillage.photoCaption} /></figcaption>
          </figure>
          <div class="feature__text">
            <h3 class="feature__title">{e.globalVillage.title}</h3>
            <p class="feature__body"><RichText text={e.globalVillage.body} /></p>
          </div>
        </article>

        <!-- Global Village aftermovie -->
        <div class="aftermovie">
          <h4 class="aftermovie__title">{e.globalVillage.aftermovieTitle}</h4>
          <div class="aftermovie__frame">
            <div class="aftermovie__ratio">
              <iframe
                src="https://www.youtube.com/embed/5nOVaCf08Yg?hd=1&vq=hd1080"
                title={e.globalVillage.aftermovieTitle}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen></iframe>
            </div>
          </div>
        </div>

        <!-- Annual trip to Amsterdam -->
        <article class="feature feature--reverse">
          <figure class="feature__photo">
            <img
              class="zoomable"
              src="/imgs/assoc/amsterdam.webp"
              alt={e.trip.photoAlt}
              width="1400"
              height="933"
              loading="lazy"
            />
            <figcaption class="feature__caption">{e.trip.photoCaption}</figcaption>
          </figure>
          <div class="feature__text">
            <h3 class="feature__title">{e.trip.title}</h3>
            <p class="feature__body"><RichText text={e.trip.body} /></p>
          </div>
        </article>

        <!-- Valentine's party -->
        <article class="feature">
          <figure class="feature__photo">
            <img
              class="zoomable"
              src="/imgs/assoc/event-valentines.webp"
              alt={e.valentines.photoAlt}
              width="1200"
              height="854"
              loading="lazy"
            />
            <figcaption class="feature__caption">{e.valentines.photoCaption}</figcaption>
          </figure>
          <div class="feature__text">
            <h3 class="feature__title">{e.valentines.title}</h3>
            <p class="feature__body"><RichText text={e.valentines.body} /></p>
          </div>
        </article>
      </div>

      <HoneyDrip fill="var(--cream-deep)" />
    </section>

    <!-- ── All year round: the recurring line-up ─────────────── -->
    <section class="band band--year">
      <div class="container">
        <p class="eyebrow"><span class="eyebrow__hex" aria-hidden="true"></span>{e.yearRoundEyebrow}</p>
        <h2>{e.yearRoundTitle}</h2>
        <p class="lede">{e.yearRoundLede}</p>

        <ul class="year-grid">
          {yearRound.map((it) => (
            <li class="year-item">
              <span class="year-item__hex" aria-hidden="true"></span>
              <h3 class="year-item__title"><RichText text={it.title} /></h3>
              <p class="year-item__body"><RichText text={it.body} /></p>
            </li>
          ))}
        </ul>

        <!-- ── Suggest your cultural event ───────────────────── -->
        <div class="suggest">
          <p class="eyebrow suggest__eyebrow">
            <span class="eyebrow__hex" aria-hidden="true"></span>
            {e.suggestBand.eyebrow}
          </p>
          <h3 class="suggest__title">{e.suggestBand.title}</h3>
          <p class="suggest__body">{e.suggestBand.body}</p>
          <a
            class="btn btn--suggest"
            href={localizedPath("/contact", lang)}
          >
            {e.suggestBand.cta}
            <svg
              class="btn__icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ── Closing CTA (honey-on-navy) ───────────────────────── -->
    <section class="band band--cta">
      <HoneyDrip fill="var(--cream-deep)" stroke="var(--honey-deep)" anchor="top-inside" />
      <HexBg
        radius={44}
        gap={2}
        opacity={0.28}
        color="var(--honey)"
        strokeWidth={2}
        hexagons={[
          [2, 1], [5, 3], [8, 2], [3, 5], [1, 4], [6, 1], [4, 4], [0, 2],
          [3, 0], [1, 6], [13, 2], [15, 4], [14, 1], [12, 5], [11, 3],
          [22, 0], [24, 3], [21, 2], [25, 5], [23, 4], [26, 1], [20, 6],
        ]}
        highlightOpacity={0.1}
        class="cta-hex-bg cta-hex-bg--desktop"
        maskImage="radial-gradient(ellipse clamp(300px, 88vw, 1100px) clamp(220px, 55vh, 460px) at center, white, transparent)"
      />
      <HexBg
        radius={24}
        gap={2}
        opacity={0.1}
        color="var(--honey)"
        strokeWidth={1.5}
        hexagons={[
          [1, 1], [3, 3], [5, 5], [2, 7], [4, 9], [0, 4], [6, 2], [7, 6],
          [9, 4], [8, 8], [10, 1], [11, 5], [12, 9], [13, 3], [14, 7],
        ]}
        highlightOpacity={0.05}
        class="cta-hex-bg cta-hex-bg--mobile"
        maskImage="linear-gradient(to right, rgba(255,255,255,0.55), white 6%, white 94%, rgba(255,255,255,0.55))"
      />

      <div class="container cta">
        <div class="cta__title-container">
          <h2 class="cta__title">
            {e.ctaTitle}
            <span class="cta__decor-bee" aria-hidden="true">
              <img src="/imgs/bee.svg" alt="" width="56" height="56" />
            </span>
          </h2>
        </div>
        <p class="cta__lede">{e.ctaLede}</p>

        <div
          class="cal-widget"
          id="cal-widget"
          data-lang={lang}
          data-no-events={e.calNoEvents}
        >
          <div class="cal-nav-bar">
            <button class="cal-nav-btn" id="cal-prev" aria-label={e.calPrevWeek}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="18" height="18">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <span class="cal-week-label" id="cal-range"></span>
            <button class="cal-nav-btn" id="cal-next" aria-label={e.calNextWeek}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="18" height="18">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
          <div class="cal-grid-wrap">
            <div class="cal-grid" id="cal-grid" aria-live="polite" aria-label="Weekly campus events"></div>
          </div>
        </div>

        <div class="cta__actions">
          <a
            class="btn btn--primary"
            href="https://cal.minet.net"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              class="btn__icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            {e.ctaMinet}
          </a>
        </div>
      </div>
    </section>

    <Footer />
    <script is:inline define:vars={{ calEvents, lang, noEventsMsg: e.calNoEvents }}>
      (function () {
        const grid = document.getElementById('cal-grid');
        const rangeEl = document.getElementById('cal-range');
        const prevBtn = document.getElementById('cal-prev');
        const nextBtn = document.getElementById('cal-next');
        if (!grid || !rangeEl) return;

        let weekOffset = 0;

        function getWeekDays(offset) {
          const now = new Date();
          const day = now.getDay();
          const monday = new Date(now);
          monday.setDate(now.getDate() - (day === 0 ? 6 : day - 1) + offset * 7);
          monday.setHours(0, 0, 0, 0);
          return Array.from({ length: 7 }, (_, i) => {
            const d = new Date(monday);
            d.setDate(monday.getDate() + i);
            return d;
          });
        }

        function isSameDay(a, b) {
          return (
            a.getFullYear() === b.getFullYear() &&
            a.getMonth() === b.getMonth() &&
            a.getDate() === b.getDate()
          );
        }

        function safeColor(c) {
          return /^#[0-9a-fA-F]{3,8}$/.test(c || '') ? c : '#EFAB43';
        }

        function esc(s) {
          const d = document.createElement('div');
          d.textContent = String(s || '');
          return d.innerHTML;
        }

        function render() {
          const days = getWeekDays(weekOffset);
          const today = new Date();

          const rangeFmt = new Intl.DateTimeFormat(lang, { month: 'long', day: 'numeric' });
          rangeEl.textContent = rangeFmt.format(days[0]) + ' – ' + rangeFmt.format(days[6]);

          const dayFmt = new Intl.DateTimeFormat(lang, { weekday: 'short' });
          const timeFmt = new Intl.DateTimeFormat(lang, { hour: '2-digit', minute: '2-digit' });

          const hasEvents = days.some((day) =>
            calEvents.some((ev) => isSameDay(new Date(ev.start_time), day))
          );

          if (!hasEvents) {
            grid.innerHTML = '<p class="cal-empty">' + esc(noEventsMsg) + '</p>';
            return;
          }

          grid.innerHTML = days
            .map((day) => {
              const isToday = isSameDay(day, today);
              const dayEvents = calEvents
                .filter((ev) => isSameDay(new Date(ev.start_time), day))
                .sort((a, b) => +new Date(a.start_time) - +new Date(b.start_time));

              const cards = dayEvents
                .map((ev) => {
                  const color = safeColor(ev.org_color);
                  const time = timeFmt.format(new Date(ev.start_time));
                  return (
                    '<a class="cal-card" href="https://cal.minet.net/events/' + encodeURIComponent(ev.id) + '" target="_blank" rel="noopener noreferrer" style="--border:' + color + '">' +
                    (ev.org_name
                      ? '<span class="cal-card__org" style="color:' + color + '">' + esc(ev.org_name) + '</span>'
                      : '') +
                    '<strong class="cal-card__title">' + esc(ev.title) + '</strong>' +
                    '<span class="cal-card__time">' +
                      '<svg class="cal-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="12" height="12"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>' +
                      esc(time) +
                    '</span>' +
                    (ev.location
                      ? '<span class="cal-card__loc">' +
                          '<svg class="cal-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="12" height="12"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>' +
                          esc(ev.location) +
                        '</span>'
                      : '') +
                    '</a>'
                  );
                })
                .join('');

              return (
                '<div class="cal-col' + (isToday ? ' cal-col--today' : '') + '">' +
                '<div class="cal-col__header">' +
                '<span class="cal-col__weekday">' + esc(dayFmt.format(day)) + '</span>' +
                '<span class="cal-col__num' + (isToday ? ' cal-col__num--today' : '') + '">' + day.getDate() + '</span>' +
                '</div>' +
                '<div class="cal-col__body">' + cards + '</div>' +
                '</div>'
              );
            })
            .join('');
        }

        if (prevBtn) prevBtn.addEventListener('click', () => { weekOffset--; render(); });
        if (nextBtn) nextBtn.addEventListener('click', () => { weekOffset++; render(); });

        render();
      })();
    </script>
  </main>
</Base>

<style>
  /* ── Shared ─────────────────────────────────────────────── */
  .container {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  .band {
    padding-block: var(--section-y);
  }

  .band--featured {
    position: relative;
  }

  .eyebrow {
    font-family: var(--font-accent);
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--honey-deep);
    margin-bottom: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .eyebrow__hex {
    display: inline-block;
    width: 13px;
    height: 11px;
    background: var(--honey);
    clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
    flex-shrink: 0;
  }

  .lede {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--navy-soft);
    margin-top: var(--space-4);
    max-width: 60ch;
  }

  h2 {
    max-width: 20ch;
  }

  /* ── Hero ──────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--honey);
    --nav-h: 96px;
    margin-top: calc(-1 * var(--nav-h));
    text-align: center;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    padding-top: calc(var(--nav-h) + clamp(var(--space-8), 10vw, var(--space-9)));
    padding-bottom: clamp(var(--space-7), 8vw, var(--space-9));
  }

  .hero__bee {
    margin-bottom: var(--space-4);
    animation: heroBeeFloat 4s ease-in-out infinite alternate;
  }
  .hero__bee img {
    width: clamp(80px, 12vw, 120px);
    height: auto;
    margin-inline: auto;
    filter: drop-shadow(4px 6px 0 rgba(30, 42, 61, 0.15));
  }

  @keyframes heroBeeFloat {
    from { transform: translateY(0) rotate(-3deg); }
    to   { transform: translateY(-8px) rotate(5deg); }
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 0.98;
    color: var(--cream);
    -webkit-text-stroke: 5px var(--ink);
    paint-order: stroke fill;
    text-shadow: 5px 5px 0 var(--ink);
    transform: rotate(-1.5deg);
    margin-bottom: var(--space-4);
  }

  .hero__lede {
    font-size: clamp(1.125rem, 1.5vw, 1.3125rem);
    line-height: 1.7;
    font-weight: 600;
    color: var(--ink);
    max-width: 50ch;
    margin-inline: auto;
  }

  @media (max-width: 979px) {
    .hero {
      --nav-h: 78px;
    }
    .hero__inner {
      padding-top: calc(var(--nav-h) + clamp(72px, 14vw, 110px));
    }
  }

  /* ── Featured events: alternating photo + text ─────────── */
  .feature {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: center;
    margin-top: var(--space-8);
  }
  @media (min-width: 860px) {
    .feature {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
    /* Reversed rows: photo sits on the right. */
    .feature--reverse .feature__photo {
      order: 2;
    }
  }

  /* Polaroid frame (matches the home photo-strip treatment). */
  .feature__photo {
    margin: 0;
    background: var(--cream);
    border: 4px solid var(--navy);
    padding: 16px 16px 0 16px;
    box-shadow: 0 0 0 1px var(--navy), 6px 6px 0 var(--navy);
    border-radius: 8px;
    transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.25);
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: rotate(-1.5deg);
  }
  .feature--reverse .feature__photo {
    transform: rotate(1.5deg);
  }
  .feature__photo:hover {
    transform: rotate(0deg) scale(1.02);
    z-index: 3;
  }
  .feature__photo img {
    width: 100%;
    height: auto;
    border: 3px solid var(--navy);
    border-radius: 4px;
    box-shadow: 2px 2px 0 rgba(41, 58, 85, 0.1);
    cursor: zoom-in;
  }
  .feature__caption {
    font-family: var(--font-accent);
    font-size: 1.15rem;
    color: var(--navy);
    text-transform: uppercase;
    padding-block: 20px;
    text-align: center;
    width: 100%;
  }

  .feature__title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.05;
    color: var(--ink);
    margin-bottom: var(--space-4);
  }
  .feature__body {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--navy-soft);
    max-width: 52ch;
  }

  /* ── Aftermovie video ──────────────────────────────────── */
  .aftermovie {
    margin-top: var(--space-8);
    text-align: center;
  }
  .aftermovie__title {
    font-family: var(--font-accent);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    color: var(--ink);
    margin-bottom: var(--space-5);
  }
  .aftermovie__frame {
    max-width: 880px;
    margin-inline: auto;
    background: var(--cream);
    border: 4px solid var(--navy);
    border-radius: 16px;
    padding: 12px;
    box-shadow: 0 0 0 1px var(--navy), 8px 8px 0 var(--navy);
    transform: rotate(-0.5deg);
    transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.25);
  }
  .aftermovie__frame:hover {
    transform: rotate(0deg);
  }
  .aftermovie__ratio {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 3px solid var(--navy);
    border-radius: 8px;
    overflow: hidden;
    background: var(--ink);
  }
  .aftermovie__ratio iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* ── All year round ────────────────────────────────────── */
  .band--year {
    position: relative;
    background-color: var(--cream-deep);
    background-image: radial-gradient(
      rgba(41, 58, 85, 0.04) 1.5px,
      transparent 1.5px
    );
    background-size: 24px 24px;
  }
  .year-grid {
    list-style: none;
    padding: 0;
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-7) var(--space-6);
  }
  /* No card boxes: a chunky hex marker + type carry each entry. */
  .year-item {
    position: relative;
    padding-top: var(--space-4);
    border-top: 2px solid var(--line);
    max-width: 38ch;
  }
  .year-item__hex {
    display: block;
    width: 26px;
    height: 23px;
    background: var(--hex-fill, var(--honey));
    clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
    margin-bottom: var(--space-3);
    transition: transform 0.22s cubic-bezier(0.175, 0.885, 0.32, 1.25);
    flex-shrink: 0;
  }
  .year-item:hover .year-item__hex {
    transform: rotate(-12deg) scale(1.12);
  }
  .year-item:nth-child(6n + 1) { --hex-fill: var(--hive-peach); }
