---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../SiteHeader.astro";
import Footer from "../Footer.astro";
import HoneyDrip from "../HoneyDrip.astro";
import HexBg from "../HexBg.astro";
import RichText from "../RichText.astro";
import { getLangFromUrl, localizedPath } from "../../i18n/utils";
import { useTranslations } from "../../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const meta = (t.meta as any).guidesAssociative ?? (t.meta as any).guidesAssociatif ?? {
  title: "Vie Associative & Clubs | Guides | WELCOM'",
  description: "Découvrez les événements phares, les campagnes, les soirées et la vie associative du campus d'Évry (Télécom SudParis & IMT-BS)."
};
const a = (t as any).associative ?? (t as any).associatif;
const lp = (t as any).lexiconPage ?? {
  title: "Campus Lexicon",
  subtitle: "Every campus acronym, place, association, and piece of student jargon explained in plain language.",
};
---

<Base title={meta.title} description={meta.description}>
  <span id="top"></span>
  <SiteHeader />

  <main class="assoc-page">

    <section class="hero">
      <HexBg
        radius={46}
        gap={6}
        opacity={0.1}
        color="var(--navy)"
        strokeWidth={2}
        hexagons={[]}
        maskImage="radial-gradient(ellipse 120% 100% at 50% 45%, white 30%, transparent 85%)"
      />

      <div class="container hero__inner">
        <div class="hero__bee" aria-hidden="true">
          <img src="/imgs/bee.svg" alt="" width="100" height="100" />
        </div>

        <p class="hero__eyebrow">
          <span class="eyebrow__hex" aria-hidden="true"></span>
          {a.heroEyebrow}
        </p>

        <h1 class="hero__title">{a.heroTitle}</h1>

        <p class="hero__lede">
          <RichText text={a.heroLede} />
        </p>

        <div class="stats-row">
          <div class="stat-card">
            <span class="stat-card__num">{a.stat1Num}</span>
            <span class="stat-card__label">{a.stat1Label}</span>
          </div>
          <div class="stat-card">
            <span class="stat-card__num">{a.stat2Num}</span>
            <span class="stat-card__label">{a.stat2Label}</span>
          </div>
          <div class="stat-card">
            <span class="stat-card__num">{a.stat3Num}</span>
            <span class="stat-card__label">{a.stat3Label}</span>
          </div>
        </div>

        <div class="hero-bde-link">
          <a href="/resources/plaquette-alpha.pdf" target="_blank" rel="noopener noreferrer" class="hero-bde-btn hero-bde-btn--primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><polyline points="9 15 12 18 15 15"/></svg>
            <span>{a.alphaPdfBtn}</span>
          </a>
          <a href="https://bde-imtbs-tsp.fr/en/associative/" target="_blank" rel="noopener noreferrer" class="hero-bde-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            <span>{a.bdeSiteBtn}</span>
          </a>
        </div>
      </div>

      <HoneyDrip fill="var(--cream-deep)" />
    </section>

    <section class="band band--alt" id="integration">
      <div class="container">
        <div class="prose-header">
          <p class="eyebrow"><span class="eyebrow__hex" aria-hidden="true"></span> {a.integrationEyebrow}</p>
          <h2>{a.integrationH2}</h2>
          <p class="lede">{a.integrationLede}</p>
        </div>

        <div class="timeline">

          <div class="timeline-item">
            <div class="timeline-marker">
              <div class="timeline-dot"></div>
              <div class="timeline-line"></div>
            </div>
            <div class="timeline-body">
              <div class="timeline-tag">{a.preSeiTag}</div>
              <h3 class="timeline-title">
                <RichText text={a.preSeiTitle} />
              </h3>
              <p class="timeline-text">
                <RichText text={a.preSeiText} />
              </p>
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-marker">
              <div class="timeline-dot timeline-dot--honey"></div>
              <div class="timeline-line"></div>
            </div>
            <div class="timeline-body">
              <div class="timeline-tag timeline-tag--honey">{a.seiTag}</div>
              <h3 class="timeline-title">
                <RichText text={a.seiTitle} />
              </h3>
              <p class="timeline-text">
                <RichText text={a.seiText} />
              </p>
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-marker">
              <div class="timeline-dot timeline-dot--navy"></div>
            </div>
            <div class="timeline-body">
              <div class="timeline-tag timeline-tag--navy">{a.weiTag}</div>
              <h3 class="timeline-title">
                <RichText text={a.weiTitle} />
              </h3>
              <p class="timeline-text">
                <RichText text={a.weiText} />
              </p>
            </div>
          </div>

        </div>

        <div class="photo-pair">
          <figure class="photo-card photo-card--tall zoomable" tabindex="0"
            data-caption={a.photoPreSeiCaption}
            style="background-image: url('/imgs/guides/associative/presei.jpg')">
            <figcaption class="photo-card__caption">{a.photoPreSeiCaption}</figcaption>
          </figure>
          <figure class="photo-card zoomable" tabindex="0"
            data-caption={a.photoWeiDataCaption}
            style="background-image: url('/imgs/guides/associative/color-run-wei.jpg')">
            <figcaption class="photo-card__caption">{a.photoWeiCaption}</figcaption>
          </figure>
        </div>
      </div>
      <HoneyDrip fill="var(--cream)" />
    </section>

    <section class="band" id="campagnes">
      <div class="container">
        <div class="prose-header">
          <p class="eyebrow"><span class="eyebrow__hex" aria-hidden="true"></span> {a.campaignsEyebrow}</p>
          <h2>{a.campaignsH2}</h2>
          <p class="lede">{a.campaignsLede}</p>
        </div>

        <div class="campaign-grid">

          <article class="campaign-card" style="--cc: #005177;">
            <div class="campaign-card__content">
              <h3 class="campaign-card__title">{a.bdeTitle}</h3>
              <p class="campaign-card__desc">
                <RichText text={a.bdeDesc} />
              </p>
            </div>
            <a href="https://bde-imtbs-tsp.fr/en/" target="_blank" rel="noopener noreferrer" class="campaign-card__btn">
              <span>{a.campaignBtnText ?? "Visit website"}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </article>

          <article class="campaign-card" style="--cc: #9B1D1D;">
            <div class="campaign-card__content">
              <h3 class="campaign-card__title">{a.bdaTitle}</h3>
              <p class="campaign-card__desc">
                <RichText text={a.bdaDesc} />
              </p>
            </div>
            <a href="https://bda-imtbs-tsp.fr/" target="_blank" rel="noopener noreferrer" class="campaign-card__btn">
              <span>{a.campaignBtnText ?? "Visit website"}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </article>

          <article class="campaign-card" style="--cc: #E91E63;">
            <div class="campaign-card__content">
              <h3 class="campaign-card__title">{a.asintTitle}</h3>
              <p class="campaign-card__desc">
                <RichText text={a.asintCampaignDesc} />
              </p>
            </div>
            <a href="https://www.asint.fr/" target="_blank" rel="noopener noreferrer" class="campaign-card__btn">
              <span>{a.campaignBtnText ?? "Visit website"}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </article>

        </div>

        <div class="photo-solo">
          <figure class="photo-card photo-card--wide zoomable" tabindex="0"
            data-caption={a.photoVoteCaption}
            style="background-image: url('/imgs/guides/associative/vote.jpg')">
            <figcaption class="photo-card__caption">{a.photoVoteCaption}</figcaption>
          </figure>
        </div>
      </div>
      <HoneyDrip fill="var(--navy)" />
    </section>

    <section class="band band--dark" id="club-b">
      <div class="container">
        <div class="club-b-layout">
          <div class="club-b-text">
            <p class="eyebrow eyebrow--light"><span class="eyebrow__hex" aria-hidden="true"></span> {a.clubBEyebrow}</p>
            <h2 class="club-b-title">{a.clubBTitle}</h2>
            <p class="club-b-lede">
              <RichText text={a.clubBLede} />
            </p>
            <ul class="club-b-details">
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span><RichText text={a.clubBDetail1} /></span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span><RichText text={a.clubBDetail2} /></span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span><RichText text={a.clubBDetail3} /></span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span><RichText text={a.clubBDetail4} /></span>
              </li>
            </ul>
          </div>
          <figure class="club-b-photo zoomable" tabindex="0"
            data-caption={a.photoClubBCaption}
            style="background-image: url('/imgs/guides/associative/inception.jpg')">
            <figcaption class="photo-card__caption">{a.photoClubBCaption}</figcaption>
          </figure>
        </div>
      </div>
      <HoneyDrip fill="var(--cream-deep)" />
    </section>

    <section class="band band--alt" id="soirees">
      <div class="container">
        <div class="prose-header">
          <p class="eyebrow"><span class="eyebrow__hex" aria-hidden="true"></span> {a.soireesEyebrow}</p>
          <h2>{a.soireesH2}</h2>
          <p class="lede"><RichText text={a.soireesLede} /></p>
        </div>

        <div class="soirees-hero">
          <div class="soirees-hero__content">
            <p class="eyebrow"><span class="eyebrow__hex" aria-hidden="true"></span> {a.winterfestEyebrow}</p>
            <h3 class="soirees-hero__title">{a.winterfestTitle}</h3>
            <p class="soirees-hero__meta">{a.winterfestMeta}</p>
            <p class="soirees-hero__desc">{a.winterfestDesc}</p>
          </div>
          <figure class="soirees-hero__photo photo-card photo-card--cinema zoomable" tabindex="0"
            data-caption={a.photoWinterfestCaption}
            style="background-image: url('/imgs/guides/associative/winterfest-1.jpg')">
            <figcaption class="photo-card__caption">{a.photoWinterfestCaption}</figcaption>
          </figure>
        </div>

        <div class="soirees-grid">
          <div class="soiree-card">
            <p class="soiree-card__eyebrow"><span class="eyebrow__hex" aria-hidden="true"></span> {a.parrainageTag}</p>
            <h4 class="soiree-card__title">{a.parrainageTitle}</h4>
            <p class="soiree-card__who">{a.parrainageWho}</p>
            <p class="soiree-card__desc">{a.parrainageDesc}</p>
          </div>

          <div class="soiree-card">
            <p class="soiree-card__eyebrow"><span class="eyebrow__hex" aria-hidden="true"></span> {a.bdasintTag}</p>
            <h4 class="soiree-card__title">{a.bdasintTitle}</h4>
            <p class="soiree-card__who">{a.bdasintWho}</p>
            <p class="soiree-card__desc">{a.bdasintDesc}</p>
          </div>

          <div class="soiree-card">
            <p class="soiree-card__eyebrow"><span class="eyebrow__hex" aria-hidden="true"></span> {a.halloweenTag}</p>
            <h4 class="soiree-card__title">{a.halloweenTitle}</h4>
            <p class="soiree-card__who">{a.halloweenWho}</p>
            <p class="soiree-card__desc">{a.halloweenDesc}</p>
          </div>

          <div class="soiree-card soiree-card--more">
            <p class="soiree-card__eyebrow"><span class="eyebrow__hex" aria-hidden="true"></span> {a.moreSoireesTag}</p>
            <h4 class="soiree-card__title">{a.moreSoireesTitle}</h4>
            <p class="soiree-card__who">{a.moreSoireesWho}</p>
            <p class="soiree-card__desc">{a.moreSoireesDesc}</p>
          </div>
        </div>
      </div>
      <HoneyDrip fill="var(--cream)" />
    </section>

    <section class="band" id="formations">
      <div class="container">
        <div class="prose-header">
          <p class="eyebrow"><span class="eyebrow__hex" aria-hidden="true"></span> {a.formationsEyebrow}</p>
          <h2>{a.formationsH2}</h2>
          <p class="lede"><RichText text={a.formationsLede} /></p>
        </div>

        <div class="formations-grid">
          <div class="formation-card">
            <div class="formation-card__header" style="--fc: #4F7EC4;">
              <h3 class="formation-card__title">MiNET</h3>
            </div>
            <ul class="formation-list">
              <li>{a.minetItem1}</li>
              <li>{a.minetItem2}</li>
              <li>{a.minetItem3}</li>
            </ul>
          </div>

          <div class="formation-card">
            <div class="formation-card__header" style="--fc: #2D3A4A;">
              <h3 class="formation-card__title">HackademINT</h3>
            </div>
            <ul class="formation-list">
              <li>{a.hackademintItem1}</li>
              <li>{a.hackademintItem2}</li>
              <li>{a.hackademintItem3}</li>
            </ul>
          </div>

          <div class="formation-card">
            <div class="formation-card__header" style="--fc: #3B7A57;">
              <h3 class="formation-card__title">Club Code</h3>
            </div>
            <ul class="formation-list">
              <li>{a.codeItem1}</li>
              <li>{a.codeItem2}</li>
              <li>{a.codeItem3}</li>
            </ul>
          </div>

          <div class="formation-card">
            <div class="formation-card__header" style="--fc: #9B1D1D;">
              <h3 class="formation-card__title">Model'IT</h3>
            </div>
            <ul class="formation-list">
              <li>{a.modelitItem1}</li>
              <li>{a.modelitItem2}</li>
              <li>{a.modelitItem3}</li>
            </ul>
          </div>

          <div class="formations-banner">
            <h4 class="formations-banner__title"><span class="eyebrow__hex" aria-hidden="true"></span> {a.bannerTitle}</h4>
            <p class="formations-banner__desc">
              <RichText text={a.bannerDesc} />
            </p>
          </div>
        </div>
      </div>
      <HoneyDrip fill="var(--cream-deep)" />
    </section>

    <section class="band band--asint" id="asint">
      <div class="container">
        <div class="asint-layout">
          <div class="asint-text">
            <p class="eyebrow"><span class="eyebrow__hex" aria-hidden="true"></span> {a.asintEyebrow}</p>
            <h2>{a.asintH2}</h2>
            <p class="asint-lede">
              <RichText text={a.asintLede} />
            </p>

            <ul class="asint-features">
              <li class="asint-feature">
                <h3 class="asint-feature__title"><span class="eyebrow__hex" aria-hidden="true"></span> {a.f1Title}</h3>
                <p class="asint-feature__desc">{a.f1Desc}</p>
              </li>
              <li class="asint-feature">
                <h3 class="asint-feature__title"><span class="eyebrow__hex" aria-hidden="true"></span> {a.f2Title}</h3>
                <p class="asint-feature__desc">{a.f2Desc}</p>
              </li>
              <li class="asint-feature">
                <h3 class="asint-feature__title"><span class="eyebrow__hex" aria-hidden="true"></span> {a.f3Title}</h3>
                <p class="asint-feature__desc">{a.f3Desc}</p>
              </li>
              <li class="asint-feature">
                <h3 class="asint-feature__title"><span class="eyebrow__hex" aria-hidden="true"></span> <RichText text={a.wesTitle} /></h3>
                <p class="asint-feature__desc"><RichText text={a.wesDesc} /></p>
              </li>
            </ul>

            <div class="asint-actions">
              <a href="https://www.asint.fr/" target="_blank" rel="noopener noreferrer" class="asint-btn">
                <span>{a.asintBtn}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            </div>
          </div>

          <figure class="asint-photo zoomable" tabindex="0"
            data-caption={a.photoAsintCaption}
            style="background-image: url('/imgs/guides/associative/asint-sei.jpg')">
            <figcaption class="photo-card__caption">{a.photoAsintCaption}</figcaption>
          </figure>
        </div>
      </div>
      <HoneyDrip fill="var(--cream-deep)" />
    </section>

    <section class="band band--lexicon-cta">
      <div class="container lexicon-cta__inner">
        <div class="lexicon-cta__text">
          <p class="eyebrow">
            <span class="eyebrow__hex" aria-hidden="true"></span>
            {t.nav.lexicon}
          </p>
          <h2 class="lexicon-cta__title">{lp.title}</h2>
          <p class="lexicon-cta__lede">{lp.subtitle}</p>
        </div>
        <div class="lexicon-cta__action">
          <a href={localizedPath("/lexicon", lang)} class="asint-btn lexicon-cta__btn">
            <span>{lp.title}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Base>

<style>
  
  .container {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  .band {
    padding-block: var(--section-y);
    position: relative;
  }

  .band--alt {
    background-color: var(--cream-deep);
    background-image: radial-gradient(rgba(41, 58, 85, 0.05) 1.5px, transparent 1.5px);
    background-size: 24px 24px;
  }

  .band--dark {
    background-color: var(--navy);
    color: var(--cream);
  }

  .band--asint {
    background: linear-gradient(135deg, var(--cream-deep) 0%, #f5e8f0 100%);
  }

  .eyebrow {
    font-family: var(--font-accent);
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--honey-deep);
    margin-bottom: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .eyebrow--light {
    color: var(--honey);
  }

  .eyebrow__hex {
    width: 13px;
    height: 11px;
    background: var(--honey);
    clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
    display: inline-block;
    flex-shrink: 0;
  }

  .prose-header {
    margin-bottom: var(--space-7);
  }

  .prose-header h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--ink);
    margin-top: var(--space-2);
  }

  .lede {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--navy-soft);
    margin-top: var(--space-3);
    max-width: 85ch;
  }

  .hero {
    position: relative;
    overflow: hidden;
    background: var(--honey);
    --nav-h: 96px;
    margin-top: calc(-1 * var(--nav-h));
    text-align: center;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    padding-top: calc(var(--nav-h) + clamp(var(--space-8), 10vw, var(--space-9)));
    padding-bottom: clamp(var(--space-7), 8vw, var(--space-9));
  }

  .hero__bee {
    margin-bottom: var(--space-4);
  }

  .hero__bee img {
    width: clamp(64px, 10vw, 100px);
    height: auto;
    margin-inline: auto;
    filter: drop-shadow(4px 6px 0 rgba(30, 42, 61, 0.15));
    animation: beeBob 4s ease-in-out infinite;
  }

  @keyframes beeBob {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-6px) rotate(1.5deg); }
  }

  .hero__eyebrow {
    font-family: var(--font-accent);
    color: var(--navy);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 1rem;
    margin-bottom: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 0.98;
    color: var(--cream);
    -webkit-text-stroke: 5px var(--ink);
