---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../SiteHeader.astro";
import HexBg from "../HexBg.astro";
import HoneyDrip from "../HoneyDrip.astro";
import RichText from "../RichText.astro";
import Footer from "../Footer.astro";
import { getLangFromUrl, localizedPath } from "../../i18n/utils";
import { useTranslations } from "../../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const topicOptions = Object.entries(t.contactPage.formTopicOptions);
---

<Base title={t.meta.contact.title}>
  <span id="top"></span>
  <SiteHeader />
  <main>
    <!-- ── Hero: contact header ──────────────────────────────── -->
    <section class="hero">
      <HexBg
        radius={46}
        gap={6}
        opacity={0.1}
        color="var(--navy)"
        strokeWidth={2}
        hexagons={[]}
        maskImage="radial-gradient(ellipse 120% 100% at 50% 45%, white 30%, transparent 85%)"
      />
      <div class="container hero__inner">
        <div class="hero__bee" aria-hidden="true">
          <img src="/imgs/bee.svg" alt="" width="120" height="120" />
        </div>
        <h1 class="hero__title">{t.contactPage.heroTitle}</h1>
        <p class="hero__lede">{t.contactPage.heroLede}</p>
      </div>
      <HoneyDrip fill="var(--cream)" />
    </section>

    <!-- ── Form + Direct contact split ───────────────────────── -->
    <section class="band band--form">
      <div class="container contact-split">
        <!-- Left: Contact form -->
        <div class="form-card" id="contact-form-card">
          <h2 class="form-card__title">{t.contactPage.formTitle}</h2>

          <form id="contact-form" class="form" novalidate>
            <div class="form__field">
              <label class="form__label" for="contact-name"
                >{t.contactPage.formName}</label
              >
              <input
                class="form__input"
                type="text"
                id="contact-name"
                name="name"
                placeholder={t.contactPage.formNamePlaceholder}
                required
                autocomplete="name"
              />
            </div>

            <div class="form__field">
              <label class="form__label" for="contact-email"
                >{t.contactPage.formEmail}</label
              >
              <input
                class="form__input"
                type="email"
                id="contact-email"
                name="email"
                placeholder={t.contactPage.formEmailPlaceholder}
                required
                autocomplete="email"
              />
            </div>

            <div class="form__field">
              <label class="form__label" for="contact-topic"
                >{t.contactPage.formTopic}</label
              >
              <div class="form__select-wrap">
                <select
                  class="form__select"
                  id="contact-topic"
                  name="topic"
                  required
                >
                  {
                    topicOptions.map(([, label]) => (
                      <option value={label}>{label}</option>
                    ))
                  }
                </select>
                <svg
                  class="form__select-chevron"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </div>
            </div>

            <div class="form__field">
              <label class="form__label" for="contact-message"
                >{t.contactPage.formMessage}</label
              >
              <textarea
                class="form__textarea"
                id="contact-message"
                name="message"
                rows="5"
                placeholder={t.contactPage.formMessagePlaceholder}
                required></textarea>
            </div>

            <button
              class="btn btn--primary form__submit"
              type="submit"
              id="contact-submit"
            >
              {t.contactPage.formSend}
            </button>

            <p class="form__note">{t.contactPage.formNote}</p>
          </form>
        </div>

        <!-- Right: Direct contact info -->
        <aside class="direct">
          <div class="direct-card" id="direct-contact-card">
            <h2 class="direct-card__title">{t.contactPage.directTitle}</h2>

            <div class="direct-list">
              <!-- Email -->
              <a
                class="direct-item"
                href="mailto:association.welcom@imtbs-tsp.eu"
                id="direct-email"
              >
                <div class="direct-item__icon" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path
                      d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                    ></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                  </svg>
                </div>
                <div class="direct-item__text">
                  <span class="direct-item__label"
                    >{t.contactPage.directEmail}</span
                  >
                  <span class="direct-item__value"
                    ><bdi>association.welcom<wbr />@imtbs-tsp.eu</bdi></span
                  >
                </div>
              </a>

              <!-- Instagram -->
              <a
                class="direct-item"
                href="https://www.instagram.com/welcom_int"
                target="_blank"
                rel="noopener noreferrer"
                id="direct-instagram"
              >
                <div class="direct-item__icon" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"
                    ></rect>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                    ></path>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                  </svg>
                </div>
                <div class="direct-item__text">
                  <span class="direct-item__label"
                    >{t.contactPage.directInstagram}</span
                  >
                  <span class="direct-item__value"><bdi>@welcom_int</bdi></span>
                </div>
              </a>

              <!-- Address -->
              <a
                class="direct-item"
                href="https://maps.app.goo.gl/BkE7fHqtwXX4cz4FA"
                target="_blank"
                rel="noopener noreferrer"
                id="direct-address"
              >
                <div class="direct-item__icon" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                    ></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                </div>
                <div class="direct-item__text">
                  <span class="direct-item__label"
                    >{t.contactPage.directAddress}</span
                  >
                  <span class="direct-item__value"
                    ><bdi
                      >9 Rue Charles Fourier,<br />91011 Évry-Courcouronnes</bdi
                    ></span
                  >
                </div>
              </a>
            </div>

            <p class="direct-card__foyer">
              <RichText text={t.contactPage.directFoyer} />
            </p>
            <a
              class="btn btn--primary direct-card__foyer-btn"
              href={localizedPath("/foyer/rdc", lang)}
              id="contact-foyer-map-btn"
            >
              <svg
                class="direct-card__foyer-btn-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"></polygon>
                <line x1="9" y1="3" x2="9" y2="18"></line>
                <line x1="15" y1="6" x2="15" y2="21"></line>
              </svg>
              <span>{t.contactBand.foyerBtn}</span>
            </a>
          </div>

          <div class="team-contacts-card" id="team-contacts-card">
            <h3 class="team-contacts-card__title">{t.contactPage.teamTitle}</h3>

            <div class="team-contacts-list">
              <!-- Manuel Brillantes Tavares -->
              <div class="person-card">
                <div class="person-card__avatar">
                  <img
                    src="/imgs/assoc/president.webp"
                    alt="Manuel Brillantes Tavares"
                    width="64"
                    height="64"
                    loading="lazy"
                  />
                </div>
                <div class="person-card__info">
                  <span class="person-card__name"
                    >Manuel Brillantes Tavares</span
                  >
                  <span class="person-card__role"
                    >{t.contactPage.presidentRole}</span
                  >
                  <a
                    class="person-card__email"
                    href="mailto:manuel.brillantes_tavares@telecom-sudparis.eu"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="person-card__email-icon"
                      aria-hidden="true"
                    >
                      <path
                        d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                      ></path>
                      <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                    <span class="person-card__email-text"
                      ><bdi
                        >manuel.brillantes_tavares<wbr />@telecom-<wbr
                        />sudparis.eu</bdi
                      ></span
                    >
                  </a>
                </div>
              </div>

              <!-- Javier Caniz -->
              <div class="person-card">
                <div class="person-card__avatar">
                  <img
                    src="/imgs/assoc/respoaccueil.webp"
                    alt="Javier Caniz"
                    width="64"
                    height="64"
                    loading="lazy"
                  />
                </div>
                <div class="person-card__info">
                  <span class="person-card__name">Javier Caniz</span>
                  <span class="person-card__role"
                    >{t.contactPage.respoAccueilRole}</span
                  >
                  <a
                    class="person-card__email"
                    href="mailto:david.caniz_meng@telecom-sudparis.eu"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="person-card__email-icon"
                      aria-hidden="true"
                    >
                      <path
                        d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                      ></path>
                      <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                    <span class="person-card__email-text"
                      ><bdi
                        >david.caniz_meng<wbr />@telecom-<wbr />sudparis.eu</bdi
                      ></span
                    >
                  </a>
                </div>
              </div>
            </div>
          </div>
        </aside>
      </div>

      <HoneyDrip fill="var(--cream-deep)" />
    </section>

    <!-- ── FAQ accordion ─────────────────────────────────────── -->
    <section class="band band--faq">
      <div class="container faq-section">
        <h2 class="faq-section__title">{t.contactPage.faqTitle}</h2>
        <div class="faq-list" id="faq-list">
          {
            t.contactPage.faq.map((item, i) => (
              <details class="faq-item" id={`faq-item-${i}`}>
                <summary class="faq-item__q">
                  <span class="faq-item__hex" aria-hidden="true" />
                  <span class="faq-item__q-text">{item.q}</span>
                  <svg
                    class="faq-item__chevron"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="6 9 12 15 18 9" />
                  </svg>
                </summary>
                <div class="faq-item__a">
                  <p>{item.a}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Base>

<script>
  function initContactForm() {
    const form = document.getElementById(
      "contact-form",
    ) as HTMLFormElement | null;
    if (!form) return;

    form.addEventListener("submit", (e) => {
      e.preventDefault();

      const name =
        (form.querySelector("#contact-name") as HTMLInputElement)?.value || "";
      const email =
        (form.querySelector("#contact-email") as HTMLInputElement)?.value || "";
      const topic =
        (form.querySelector("#contact-topic") as HTMLSelectElement)?.value ||
        "";
      const message =
        (form.querySelector("#contact-message") as HTMLTextAreaElement)
          ?.value || "";

      const subject = encodeURIComponent(`[Welcom' Contact] ${topic}`);
      const body = encodeURIComponent(
        `Name: ${name}\nEmail: ${email}\nTopic: ${topic}\n\n${message}`,
      );

      window.location.href = `mailto:association.welcom@imtbs-tsp.eu?subject=${subject}&body=${body}`;
    });
  }

  initContactForm();
  document.addEventListener("astro:after-swap", initContactForm);
</script>

<style>
  /* ── Shared ─────────────────────────────────────────────── */
  .container {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  .band {
    padding-block: var(--section-y);
  }

  /* ── Hero ──────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--honey);
    --nav-h: 96px;
    margin-top: calc(-1 * var(--nav-h));
    text-align: center;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    padding-top: calc(
      var(--nav-h) + clamp(var(--space-8), 10vw, var(--space-9))
    );
    padding-bottom: clamp(var(--space-7), 8vw, var(--space-9));
  }

  .hero__bee {
    margin-bottom: var(--space-4);
    animation: heroBeeFloat 4s ease-in-out infinite alternate;
  }
  .hero__bee img {
    width: clamp(80px, 12vw, 120px);
    height: auto;
    margin-inline: auto;
    filter: drop-shadow(4px 6px 0 rgba(30, 42, 61, 0.15));
  }

  @keyframes heroBeeFloat {
    from {
      transform: translateY(0) rotate(-3deg);
    }
    to {
      transform: translateY(-8px) rotate(5deg);
    }
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 0.98;
    color: var(--cream);
    -webkit-text-stroke: 5px var(--ink);
    paint-order: stroke fill;
    text-shadow: 5px 5px 0 var(--ink);
    transform: rotate(-1.5deg);
    margin-bottom: var(--space-4);
  }

  .hero__lede {
    font-size: clamp(1.125rem, 1.5vw, 1.3125rem);
    line-height: 1.7;
    font-weight: 600;
    color: var(--ink);
    max-width: 48ch;
    margin-inline: auto;
  }

  @media (max-width: 979px) {
    .hero {
      --nav-h: 78px;
    }
    .hero__inner {
      padding-top: calc(var(--nav-h) + clamp(72px, 14vw, 110px));
    }
  }

  /* ── Form + Direct split ───────────────────────────────── */
  .band--form {
    position: relative;
  }

  .contact-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    align-items: start;
  }

  @media (min-width: 860px) {
    .contact-split {
      grid-template-columns: 1.3fr 1fr;
      gap: var(--space-6);
    }
  }

  .direct {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  @media (min-width: 860px) {
    .direct {
      gap: var(--space-6);
    }
  }

  /* ── Form card ──────────────────────────────────────────── */
  .form-card {
    background: var(--cream);
    border: 4px solid var(--navy);
    border-radius: 20px;
    padding: var(--space-6);
    box-shadow:
      0 0 0 1px var(--navy),
      8px 8px 0 var(--navy);
  }

  .form-card__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--ink);
    margin-bottom: var(--space-5);
    max-width: none;
  }

  .form__field {
    margin-bottom: var(--space-5);
  }

  .form__label {
    display: block;
    font-family: var(--font-accent);
    font-size: 0.95rem;
    letter-spacing: 0.03em;
    color: var(--navy);
    margin-bottom: var(--space-2);
  }

  .form__input,
  .form__select,
  .form__textarea {
    width: 100%;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    color: var(--navy);
    background: var(--cream-deep);
    border: 3px solid var(--navy);
    border-radius: var(--radius-button);
    padding: 0.75em 1em;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      background-color 0.15s ease;
  }

  .form__input::placeholder,
  .form__textarea::placeholder {
    color: var(--navy-soft);
    opacity: 0.6;
    font-weight: 400;
  }

  .form__input:focus,
  .form__select:focus,
  .form__textarea:focus {
    outline: none;
    border-color: var(--honey-deep);
    box-shadow: 0 0 0 3px rgba(239, 171, 67, 0.3);
    background: var(--cream);
  }

  .form__select-wrap {
    position: relative;
  }

  .form__select {
    appearance: none;
    cursor: pointer;
    padding-inline-end: 2.5em;
  }

  .form__select-chevron {
    position: absolute;
    top: 50%;
    right: 0.75em;
    width: 18px;
    height: 18px;
    color: var(--navy);
    transform: translateY(-50%);
    pointer-events: none;
  }

  :global([dir="rtl"]) .form__select-chevron {
    right: auto;
    left: 0.75em;
  }

  :global([dir="rtl"]) .form__select {
    padding-inline-end: 1em;
    padding-inline-start: 2.5em;
  }

  .form__textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form__submit {
    width: 100%;
    justify-content: center;
    font-size: 1.125rem;
    padding: 0.9em 1.5em;
    cursor: pointer;
  }

  .form__note {
    font-size: 0.875rem;
    color: var(--navy-soft);
    text-align: center;
    margin-top: var(--space-3);
  }

  /* ── Buttons (same as home) ─────────────────────────────── */
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-accent);
    font-size: 1.0625rem;
    text-decoration: none;
    padding: 0.8em 1.4em;
    border-radius: var(--radius-button);
    border: 3px solid var(--navy);
    min-height: 44px;
    transition:
      transform 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.25),
      box-shadow 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.25),
      background-color 0.15s ease-out;
  }

  .btn--primary {
    background: var(--honey);
    color: var(--ink);
    border-color: var(--navy);
    box-shadow:
      0 0 0 1px var(--navy),
      4px 4px 0 var(--navy);
  }
  .btn--primary:hover {
    background: var(--honey-deep);
    transform: translate(-3px, -3px);
    box-shadow:
      0 0 0 1px var(--navy),
      7px 7px 0 var(--navy);
  }
  .btn--primary:active {
    transform: translate(4px, 4px);
    box-shadow:
      0 0 0 1px var(--navy),
      0px 0px 0 var(--navy);
  }

  /* ── Direct contact cards ───────────────────────────────── */
  .direct-card {
    background: var(--cream);
    border: 4px solid var(--navy);
    border-radius: 20px;
    padding: var(--space-6);
    box-shadow:
      0 0 0 1px var(--navy),
      8px 8px 0 var(--navy);
  }

  .direct-card__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--ink);
    margin-bottom: var(--space-5);
    max-width: none;
  }

  .direct-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .direct-item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    background: var(--cream-deep);
    border: 3px solid var(--navy);
    border-radius: var(--radius-button);
    padding: var(--space-4);
    color: var(--navy);
    text-decoration: none;
    transition:
      transform 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.25),
      box-shadow 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.25),
      background-color 0.15s ease-out;
  }

  a.direct-item {
    box-shadow:
      0 0 0 1px var(--navy),
      4px 4px 0 var(--navy);
  }

  a.direct-item:hover {
    background: var(--honey-wash);
    transform: translate(-3px, -3px);
    box-shadow:
      0 0 0 1px var(--navy),
      7px 7px 0 var(--navy);
  }

  a.direct-item:active {
    transform: translate(3px, 3px);
    box-shadow:
      0 0 0 1px var(--navy),
      0px 0px 0 var(--navy);
  }

  .direct-item__icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    background: var(--honey);
    border: 2px solid var(--navy);
    border-radius: 10px;
  }

  .direct-item__icon svg {
    width: 20px;
    height: 20px;
    color: var(--ink);
  }

  .direct-item__text {
    flex: 1;
    min-width: 0;
  }

  .direct-item__label {
    display: block;
    font-family: var(--font-accent);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    color: var(--navy-soft);
    text-transform: uppercase;
    line-height: 1.2;
    margin-bottom: 2px;
  }

  .direct-item__value {
    display: block;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--navy);
    line-height: 1.4;
    word-break: break-word;
  }

  .direct-card__foyer {
    margin-top: var(--space-5);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--navy-soft);
    line-height: 1.6;
    border-top: 2px dashed rgba(41, 58, 85, 0.15);
    padding-top: var(--space-4);
  }

  .direct-card__foyer-btn {
    margin-top: var(--space-3);
    width: 100%;
    justify-content: center;
  }

  .direct-card__foyer-btn-icon {
    width: 20px;
