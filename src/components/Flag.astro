---

import { localeMeta, type Locale } from "../i18n/config";

interface Props {
  lang: Locale;
  class?: string;
}

const { lang, class: className } = Astro.props;
const { flag } = localeMeta[lang];
---

<img
  class:list={["flag", className]}
  src={`/imgs/flags/${flag}.svg`}
  alt=""
  aria-hidden="true"
  width="24"
  height="16"
  loading="lazy"
  decoding="async"
/>

<style>
  .flag {
    display: block;
    flex-shrink: 0;
    width: 24px;
    height: 16px;
    object-fit: cover;
    border: 2px solid var(--navy);
    border-radius: 4px;
    box-shadow: 0 0 0 1px var(--navy), 1.5px 1.5px 0 var(--navy);
  }
</style>
