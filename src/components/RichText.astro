---
/* Renders a string with {Term} placeholders (glossary terms), inline <strong> markdown (**text**), and inline HTML. */
import LexiconTerm from "./LexiconTerm.astro";

interface Props {
  text: string;
}

const { text } = Astro.props;
const segments = text.split(/(\{[^}]+\})/g);
---

{
  segments.map((seg) => {
    const match = seg.match(/^\{(.+)\}$/);
    if (match) {
      const term = match[1];
      return <LexiconTerm term={term}>{term}</LexiconTerm>;
    }
    const htmlContent = seg.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
    return <Fragment set:html={htmlContent} />;
  })
}
