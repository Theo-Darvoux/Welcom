---
interface Props {
  id: string;
  class?: string;
}

const { id, class: className = "" } = Astro.props;
const iconId = id === "events-buddy" ? "associative" : id;
---

<img
  src={`/imgs/hive/${iconId}.svg`}
  alt=""
  class={`hive-icon ${className}`}
  width="64"
  height="64"
  loading="lazy"
  decoding="async"
  aria-hidden="true"
/>

<style>
  .hive-icon {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
