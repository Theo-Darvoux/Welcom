---
interface Props {
  id: string;
  class?: string;
}

const { id, class: className = "" } = Astro.props;
---

{id === "getting-here" && (
  <svg class={`hive-icon ${className}`} viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    <!-- Cloud Background -->
    <path d="M 10,46 A 7,7 0 0,1 18,34 A 11,11 0 0,1 42,34 A 7,7 0 0,1 50,46 Z" fill="var(--sky)" opacity="0.45" stroke="none" />
    
    <!-- Airplane (Front-facing) -->
    <!-- Tail Fin (Back) -->
    <path d="M 32,24 L 32,10 L 36,10 Z" fill="var(--honey)" stroke="var(--navy)" stroke-width="3" />
    
    <!-- Wings (Left & Right, slightly swept down for dynamics) -->
    <path d="M 6,38 C 14,35 20,34 32,34 C 44,34 50,35 58,38 C 52,43 44,43 32,43 C 20,43 12,43 6,38 Z" fill="var(--honey)" stroke="var(--navy)" stroke-width="3" stroke-linejoin="round" />
    
    <!-- Left & Right Engines under wings -->
    <rect x="14" y="38" width="6" height="8" rx="2" fill="var(--cream-deep)" stroke="var(--navy)" stroke-width="3" />
    <rect x="44" y="38" width="6" height="8" rx="2" fill="var(--cream-deep)" stroke="var(--navy)" stroke-width="3" />

    <!-- Fuselage Body (Center Circle) -->
    <circle cx="32" cy="35" r="11" fill="var(--cream)" stroke="var(--navy)" stroke-width="3" />
    
    <!-- Cockpit Windshield (Cute visor shape) -->
    <path d="M 24,32 C 24,24 40,24 40,32 Z" fill="var(--sky)" stroke="var(--navy)" stroke-width="2.5" />
    <path d="M 35,27 L 37,30" stroke="var(--cream)" stroke-width="1.8" />
    
    <!-- Nose Cone -->
    <circle cx="32" cy="38" r="3.5" fill="var(--honey)" stroke="var(--navy)" stroke-width="2.5" />
  </svg>
)}

{id === "housing" && (
  <svg class={`hive-icon ${className}`} viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    <!-- Chimney -->
    <rect x="42" y="16" width="6" height="12" rx="1.5" fill="var(--cream-deep)" stroke="var(--navy)" stroke-width="3" />
    <circle cx="45" cy="10" r="2" fill="none" stroke="var(--navy)" stroke-width="1.8" />
    
    <!-- House Base -->
    <rect x="18" y="32" width="28" height="24" rx="4" fill="var(--cream-deep)" stroke="var(--navy)" stroke-width="3" />
    
    <!-- Roof (Symmetrical triangle overlay) -->
    <polygon points="10,34 32,14 54,34" fill="var(--honey)" stroke="var(--navy)" stroke-width="3" />
    
    <!-- Door -->
    <path d="M 27,56 L 27,44 C 27,41 37,41 37,44 L 37,56 Z" fill="var(--green)" stroke="var(--navy)" stroke-width="3" />
    <circle cx="30" cy="50" r="1" fill="var(--navy)" stroke="var(--navy)" stroke-width="1" />
    
    <!-- Window -->
    <circle cx="32" cy="25" r="5" fill="var(--sky)" stroke="var(--navy)" stroke-width="2.5" />
    <line x1="32" y1="20" x2="32" y2="30" stroke="var(--navy)" stroke-width="1.5" />
    <line x1="27" y1="25" x2="37" y2="25" stroke="var(--navy)" stroke-width="1.5" />
  </svg>
)}

{id === "admin-aid" && (
  <svg class={`hive-icon ${className}`} viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    <!-- Clipboard base -->
    <rect x="16" y="14" width="32" height="42" rx="6" fill="var(--cream-deep)" stroke="var(--navy)" stroke-width="3" />
    
    <!-- Paper Sheet -->
    <rect x="20" y="18" width="24" height="34" rx="3" fill="var(--cream)" stroke="var(--navy)" stroke-width="2" />
    
    <!-- Clip -->
    <rect x="27" y="10" width="10" height="6" rx="2" fill="var(--honey)" stroke="var(--navy)" stroke-width="2.5" />
    
    <!-- Writing Lines -->
    <line x1="25" y1="26" x2="35" y2="26" stroke="var(--navy-soft)" stroke-width="2.5" />
    <line x1="25" y1="32" x2="39" y2="32" stroke="var(--navy-soft)" stroke-width="2.5" />
    <line x1="25" y1="38" x2="33" y2="38" stroke="var(--navy-soft)" stroke-width="2.5" />
    
    <!-- Checkmark Badge in Bottom Right -->
    <circle cx="44" cy="46" r="10" fill="var(--green)" stroke="var(--navy)" stroke-width="3" />
    <path d="M 39,46 L 42,49 L 49,42" stroke="var(--cream)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{id === "money-phone" && (
  <svg class={`hive-icon ${className}`} viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    <!-- Banknote -->
    <g transform="translate(20, 36) rotate(-10) translate(-20, -36)">
      <rect x="4" y="24" width="32" height="20" rx="3" fill="var(--green)" stroke="var(--navy)" stroke-width="3" />
      <circle cx="20" cy="34" r="5" fill="var(--honey-wash)" stroke="var(--navy)" stroke-width="2.5" />
      <line x1="9" y1="34" x2="11" y2="34" stroke="var(--navy)" stroke-width="2.5" />
      <line x1="29" y1="34" x2="31" y2="34" stroke="var(--navy)" stroke-width="2.5" />
    </g>
    
    <!-- Smartphone -->
    <g transform="translate(42, 32) rotate(5) translate(-42, -32)">
      <rect x="30" y="12" width="24" height="42" rx="5" fill="var(--navy)" stroke="var(--navy)" stroke-width="3" />
      <rect x="33" y="15" width="18" height="31" rx="2" fill="var(--sky)" stroke="none" />
      <!-- Coin inside screen -->
      <circle cx="42" cy="30" r="5" fill="var(--honey)" stroke="var(--navy)" stroke-width="2" />
      <path d="M 42,28 L 42,32 M 40,30 L 44,30" stroke="var(--navy)" stroke-width="1.2" />
      <circle cx="42" cy="50" r="1.5" fill="var(--cream)" stroke="none" />
    </g>
  </svg>
)}

{id === "getting-around" && (
  <svg class={`hive-icon ${className}`} viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    <!-- Perspective Tracks -->
    <!-- Sleepers (Ties) -->
    <path d="M 12,58 L 52,58" stroke="var(--navy-soft)" stroke-width="3.5" />
    <path d="M 17,54 L 47,54" stroke="var(--navy-soft)" stroke-width="3" />
    <path d="M 22,51 L 42,51" stroke="var(--navy-soft)" stroke-width="2.5" />
    
    <!-- Converging rails -->
    <path d="M 8,60 L 22,50" stroke="var(--navy-soft)" stroke-width="3" />
    <path d="M 56,60 L 42,50" stroke="var(--navy-soft)" stroke-width="3" />
    
    <!-- Train Body -->
    <path d="M 14,24 C 14,14 20,10 32,10 C 44,10 50,14 50,24 L 50,46 C 50,49 47,50 44,50 L 20,50 C 17,50 14,49 14,46 Z" fill="var(--cream)" stroke="var(--navy)" stroke-width="3" />
    
    <!-- Windshield -->
    <rect x="18" y="16" width="28" height="14" rx="3" fill="var(--sky)" stroke="var(--navy)" stroke-width="2.5" />
    <!-- Highlight on Windshield -->
    <path d="M 38,18 L 42,26" stroke="var(--cream)" stroke-width="2" />
    
    <!-- Stripe -->
    <path d="M 14,36 L 50,36" stroke="var(--navy)" stroke-width="3" />
    
    <!-- Headlights -->
    <circle cx="21" cy="43" r="4.5" fill="var(--honey)" stroke="var(--navy)" stroke-width="2.5" />
    <circle cx="43" cy="43" r="4.5" fill="var(--honey)" stroke="var(--navy)" stroke-width="2.5" />
  </svg>
)}

{id === "daily-life" && (
  <svg class={`hive-icon ${className}`} viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    <!-- Steam rising from the cup -->
    <path d="M 26,16 Q 29,12 26,8" stroke="var(--sky)" stroke-width="2.5" stroke-linecap="round" fill="none" />
    <path d="M 33,16 Q 36,12 33,8" stroke="var(--sky)" stroke-width="2.5" stroke-linecap="round" fill="none" />
    
    <!-- Cookie/Biscuit next to the mug (bottom left) -->
    <circle cx="20" cy="46" r="8" fill="var(--honey-wash)" stroke="var(--navy)" stroke-width="3" />
    <!-- Chocolate Chips -->
    <circle cx="17" cy="43" r="1.2" fill="var(--navy)" stroke="none" />
    <circle cx="23" cy="44" r="1.2" fill="var(--navy)" stroke="none" />
    <circle cx="19" cy="48" r="1.2" fill="var(--navy)" stroke="none" />
    
    <!-- Mug Body -->
    <rect x="23" y="22" width="22" height="26" rx="5" fill="var(--honey)" stroke="var(--navy)" stroke-width="3" />
    
    <!-- Mug Handle -->
    <path d="M 45,28 C 51,28 51,42 45,42" fill="none" stroke="var(--navy)" stroke-width="3" />
    
    <!-- Cute heart logo on the mug -->
    <path d="M 34,32 C 33,30 30,30 30,32 C 30,35 34,38 34,38 C 34,38 38,35 38,32 C 38,30 35,30 34,32 Z" fill="var(--cream)" stroke="none" />
  </svg>
)}

{id === "studies" && (
  <svg class={`hive-icon ${className}`} viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    <!-- Open Book Cover -->
    <path d="M 12,48 C 16,44 28,44 32,48 C 36,44 48,44 52,48 L 52,32 C 48,28 36,28 32,32 C 28,28 16,28 12,32 Z" fill="var(--honey)" stroke="var(--navy)" stroke-width="3" />
    
    <!-- Pages Stack -->
    <path d="M 14,46 C 18,42 29,42 32,46 C 35,42 46,42 50,46 L 50,30 C 46,26 35,26 32,30 C 29,26 18,26 14,30 Z" fill="var(--cream)" stroke="var(--navy)" stroke-width="2.5" />
    
    <!-- Page Lines -->
    <path d="M 18,34 L 28,34 M 18,39 L 26,39 M 36,34 L 46,34 M 38,39 L 46,39" stroke="var(--navy-soft)" stroke-width="2" />
    
    <!-- Graduation Cap (floating above) -->
    <g transform="translate(0, -5)">
      <!-- Cap Skullcap -->
      <path d="M 22,22 L 22,27 C 22,31 42,31 42,27 L 42,22" fill="var(--navy)" stroke="var(--navy)" stroke-width="3" />
      
      <!-- Cap Diamond -->
      <polygon points="32,11 52,17 32,23 12,17" fill="var(--navy)" stroke="var(--navy)" stroke-width="3" />
      
      <!-- Tassel -->
      <path d="M 32,17 L 46,21 L 46,27" stroke="var(--honey)" stroke-width="2" />
      <circle cx="46" cy="28" r="1.2" fill="var(--honey)" stroke="none" />
    </g>
  </svg>
)}

{(id === "events-buddy" || id === "associative") && (
  <svg class={`hive-icon ${className}`} viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    <!-- Stinger (symmetrical at the bottom) -->
    <polygon points="32,53 29,46 35,46" fill="var(--navy)" stroke="var(--navy)" stroke-width="2" />
    
    <!-- Symmetrical Wings (left & right) -->
    <!-- Left Wing -->
    <path d="M 25,28 C 10,24 6,38 22,35 Z" fill="var(--sky)" opacity="0.8" stroke="var(--navy)" stroke-width="3" />
    <!-- Right Wing -->
    <path d="M 39,28 C 54,24 58,38 42,35 Z" fill="var(--sky)" opacity="0.8" stroke="var(--navy)" stroke-width="3" />
    
    <!-- Chubby Body (Symmetrical Capsule) -->
    <rect x="24" y="20" width="16" height="27" rx="8" fill="var(--honey)" stroke="var(--navy)" stroke-width="3" />
    
    <!-- Clean Symmetrical Stripes -->
    <line x1="24.5" y1="28" x2="39.5" y2="28" stroke="var(--navy)" stroke-width="3.5" />
    <line x1="24.5" y1="35" x2="39.5" y2="35" stroke="var(--navy)" stroke-width="3.5" />
    <line x1="24.5" y1="41" x2="39.5" y2="41" stroke="var(--navy)" stroke-width="3.5" />
    
    <!-- Head (Symmetrical circle on top) -->
    <circle cx="32" cy="15" r="6" fill="var(--navy)" stroke="none" />
    
    <!-- Antennae -->
    <path d="M 30,10 Q 26,6 26,6" stroke="var(--navy)" stroke-width="2.5" stroke-linecap="round" />
    <path d="M 34,10 Q 38,6 38,6" stroke="var(--navy)" stroke-width="2.5" stroke-linecap="round" />
  </svg>
)}

<style>
  .hive-icon {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
</style>
