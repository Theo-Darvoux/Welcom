---
import { getLangFromUrl, localizedPath } from "../../../i18n/utils";
import { prefixedLocales } from "../../../i18n/config";

export function getStaticPaths() {
  return prefixedLocales.map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const redirectPath = localizedPath("/events", lang);
void redirectPath;
return Astro.redirect(redirectPath, 302);
---
