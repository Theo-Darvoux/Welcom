---
import PlaceholderBody from "../../components/pages/PlaceholderBody.astro";
import ContactBody from "../../components/pages/ContactBody.astro";
import EventsBody from "../../components/pages/EventsBody.astro";
import GuidesBody from "../../components/pages/GuidesBody.astro";
import LegalBody from "../../components/pages/LegalBody.astro";
import LexiconBody from "../../components/pages/LexiconBody.astro";
import { prefixedLocales, type Locale } from "../../i18n/config";
import { localizedPath } from "../../i18n/utils";

type PageSlug = "guides" | "events" | "contact" | "foyer" | "wip" | "legal" | "lexicon";

export function getStaticPaths() {
  const pages: PageSlug[] = ["guides", "events", "contact", "foyer", "wip", "legal", "lexicon"];
  return prefixedLocales.flatMap((lang) =>
    pages.map((slug) => ({ params: { lang, slug } })),
  );
}

const { lang, slug } = Astro.params;
const foyerPath = localizedPath("/foyer/rdc", lang as Locale);
void foyerPath;

if (slug === "foyer") {
  return Astro.redirect(foyerPath);
}
---

{
  slug === "contact" ? (
    <ContactBody />
  ) : slug === "events" ? (
    <EventsBody />
  ) : slug === "guides" ? (
    <GuidesBody />
  ) : slug === "legal" ? (
    <LegalBody />
  ) : slug === "lexicon" ? (
    <LexiconBody />
  ) : (
    <PlaceholderBody page={slug as Exclude<PageSlug, "contact" | "events" | "foyer" | "guides" | "legal" | "lexicon">} />
  )
}
