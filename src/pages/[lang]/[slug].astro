---
import PlaceholderBody from "../../components/pages/PlaceholderBody.astro";
import ContactBody from "../../components/pages/ContactBody.astro";
import EventsBody from "../../components/pages/EventsBody.astro";
import { prefixedLocales } from "../../i18n/config";
import { localizedPath, type Locale } from "../../i18n/utils";

type PageSlug = "guides" | "events" | "contact" | "foyer";

// Each placeholder page per non-default locale: /fr/guides, /es/contact, …
// (getStaticPaths runs in an isolated scope, so its data lives inside it.)
export function getStaticPaths() {
  const pages: PageSlug[] = ["guides", "events", "contact", "foyer"];
  return prefixedLocales.flatMap((lang) =>
    pages.map((slug) => ({ params: { lang, slug } })),
  );
}

const { lang, slug } = Astro.params;

if (slug === "foyer") {
  return Astro.redirect(localizedPath("/foyer/rdc", lang as Locale));
}
---

{
  slug === "contact" ? (
    <ContactBody />
  ) : slug === "events" ? (
    <EventsBody />
  ) : (
    <PlaceholderBody page={slug as Exclude<PageSlug, "contact" | "events" | "foyer">} />
  )
}
