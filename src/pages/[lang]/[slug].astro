---
import PlaceholderBody from "../../components/pages/PlaceholderBody.astro";
import ContactBody from "../../components/pages/ContactBody.astro";
import { prefixedLocales } from "../../i18n/config";

type PageSlug = "guides" | "team" | "events" | "contact";

// Each placeholder page per non-default locale: /fr/guides, /es/team, …
// (getStaticPaths runs in an isolated scope, so its data lives inside it.)
export function getStaticPaths() {
  const pages: PageSlug[] = ["guides", "team", "events", "contact"];
  return prefixedLocales.flatMap((lang) =>
    pages.map((slug) => ({ params: { lang, slug } })),
  );
}

const { slug } = Astro.params;
---

{slug === "contact" ? <ContactBody /> : <PlaceholderBody page={slug as Exclude<PageSlug, "contact">} />}
