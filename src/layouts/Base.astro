---
import "../styles/tokens.css";
import "../styles/global.css";
import { localeMeta, locales, defaultLang } from "../i18n/config";
import { getLangFromUrl, stripLocale, localizedPath } from "../i18n/utils";
import ImageLightbox from "../components/ImageLightbox.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "WELCOM, the hive that helps international students settle in at Télécom SudParis & IMT-BS, Évry campus.",
  image = "/imgs/logo.webp",
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const { htmlLang, dir } = localeMeta[lang];

const siteOrigin = Astro.site ? Astro.site.origin : Astro.url.origin;
const canonicalPath = stripLocale(Astro.url.pathname);
const currentLocalizedPath = localizedPath(canonicalPath, lang);
const canonicalUrl = new URL(currentLocalizedPath, siteOrigin).href;
const ogImageUrl = new URL(image, siteOrigin).href;

const alternateLinks = locales.map((l) => ({
  hreflang: localeMeta[l].htmlLang,
  href: new URL(localizedPath(canonicalPath, l), siteOrigin).href,
}));

const xDefaultUrl = new URL(localizedPath(canonicalPath, defaultLang), siteOrigin).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "Welcom'INT",
  "alternateName": "WELCOM",
  "url": siteOrigin,
  "logo": new URL("/imgs/logo.webp", siteOrigin).href,
  "description": description,
  "sameAs": [
    "https://www.telecom-sudparis.eu/",
    "https://www.imt-bs.eu/"
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Évry-Courcouronnes",
    "addressCountry": "FR"
  }
};
---

<!doctype html>
<html lang={htmlLang} dir={dir}>
  <head>
    {
      lang === defaultLang && (
        <script is:inline define:vars={{ locales, defaultLang }}>
          (function () {
  try {
    var path = location.pathname.split("/").filter(Boolean);

    if (path[0] && locales.indexOf(path[0]) !== -1) return;

    function pick(prefs) {
      var lower = locales.map(function (l) { return l.toLowerCase(); });
      for (var i = 0; i < prefs.length; i++) {
        var tag = String(prefs[i]).toLowerCase();
        var parts = tag.split("-");
        var primary = parts[0];
        var exact = lower.indexOf(tag);
        if (exact !== -1) return locales[exact];
        if (primary === "zh") {
          var trad =
            tag.indexOf("hant") !== -1 ||
            parts.indexOf("tw") !== -1 ||
            parts.indexOf("hk") !== -1 ||
            parts.indexOf("mo") !== -1;
          return trad ? "zh-TW" : "zh-CN";
        }
        if (primary === "pt") return "pt-BR";
        for (var j = 0; j < locales.length; j++) {
          if (locales[j].toLowerCase().split("-")[0] === primary) return locales[j];
        }
      }
      return defaultLang;
    }

    var stored = null;
    try { stored = localStorage.getItem("welcom:lang"); } catch { void 0; }
    var target =
      stored && locales.indexOf(stored) !== -1
        ? stored
        : pick(navigator.languages || [navigator.language || defaultLang]);

    if (!target || target === defaultLang) return;

    var clean = location.pathname.replace(/^\/+|\/+$/g, "");
    var dest = "/" + target + (clean ? "/" + clean : "");
    location.replace(dest + location.search + location.hash);
  } catch { void 0; }
})();
        </script>
      )
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="icon" type="image/svg+xml" href="/imgs/bee.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title}</title>

    <link rel="canonical" href={canonicalUrl} />

    {alternateLinks.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Welcom'INT" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={htmlLang} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
    <ImageLightbox />
  </body>
</html>
